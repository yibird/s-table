{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "es5",
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "**/*.min.js",
    "docs/.vitepress/config.ts.timestamp-*.mjs"
  ]
}
