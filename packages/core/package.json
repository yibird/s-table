{
  "name": "@zchengfeng/s-table-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core types, state machines and utilities for STable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zchengfeng/s-table.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zchengfeng/s-table#readme",
  "license": "ISC",
